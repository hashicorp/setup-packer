{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es6",
    "module": "es2022",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "types": ["node"],
    "outDir": "./dist",
    "pretty": true,
    "removeComments": true,
    "sourceMap": true,
    "strict": true
  },
  "exclude": [
    "node_modules"
  ]
}
